# ===================================================
# Python + UV Modern .gitignore (2025)
# Optimized for uv package manager and modern Python development
# ===================================================

# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Testing and coverage
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.pytest_cache/
.hypothesis/
cover/
*.cover
*.py,cover
test-results/
test-reports/

# UV package manager (modern Python package management)
.uv/
uv.lock.bak
.venv*/
.venv/
venv*/
env*/
ENV*/

# Python environments
.env
.env.*

# IDE and editors
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.kite/
.claude/
CLAUDE.md
.kiro/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
Thumbs.db:encryptable

# Modern Python tooling
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.black/
.isort/
.pylint.d/
.bandit/
.safety/
.serena/
.context7/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints/
.jupyter/

# Documentation builds
docs/_build/
/site

# ===================================================
# String-Multitool Specific
# ===================================================

# Personal configuration files
config/*_personal.json
config/*_local.json
config/*_user.json
config/*_custom.json
config/*.json.bak

# RSA encryption keys (SECURITY CRITICAL - NEVER COMMIT!)
rsa/
*.pem
*.key
*.pub
*_rsa*

# Application logs and temporary files
logs/
*.log
*.pid
*.tmp
*.temp
*.bak
hotkey_session.log
daemon.pid

# Build artifacts
*.exe
*.msi
*.dmg
*.pkg
version_info.txt.bak

# Test output
test_output/
test_results/
test_*.txt
test_*.json

# User data and caches
user_data/
settings/
preferences/
cache/
.cache/

# Development environment
.devcontainer/
.gitpod/
.devenv/

# Modern CI/CD
.github/workflows/*.yml.bak
.pre-commit-config.yaml.bak

# AI/ML related (modern Python projects)
.wandb/
mlruns/
.neptune/
.ollama/
.huggingface/

# Container development
.devcontainer/
.devpod/
Dockerfile.bak
docker-compose*.yml.bak

# Security scanning results
vulnerability_reports/
security_scan_*.json
secrets_scan_*.log

# Performance profiling
.prof
*.pstats
.benchmark/

# Package management alternatives (for reference)
poetry.lock.bak
Pipfile.bak
requirements*.txt.bak
pdm.lock

# Future reference (moved features)
future_reference/
!future_reference/README.md

# Note: Essential files like pyproject.toml, uv.lock, and .vscode/settings.json are NOT ignored